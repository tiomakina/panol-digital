# Credenciales para el email de resumen del mantenimiento mensual
# Copiar este archivo como: scripts/.maintenance-email.conf
# (ese archivo está en .gitignore — nunca se sube al repositorio)

# Cuenta Gmail que envía el email
SMTP_USER=tu-cuenta@gmail.com

# Contraseña de aplicación de Google (NO tu contraseña normal)
# Obtenerla en: https://myaccount.google.com/apppasswords
# → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
# → Seleccionar app: "Correo" → Seleccionar dispositivo: "Otro (nombre personalizado)"
# → Escribe "panol360-servidor" → Generar
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Dirección donde llega el resumen (puede ser distinta al remitente)
EMAIL_TO=vmoraless@gmail.com

# Configuración SMTP (no cambiar para Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
