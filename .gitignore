# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Backups generados por scripts/backup.sh
backups/

# Entorno
.env

# Snapshot local de Redis (dev) — no es parte del código
dump.rdb

# Uploads de usuario (logos, fotos, QR, vales) — se conservan los directorios via .gitkeep
backend/app/static/uploads/*
!backend/app/static/uploads/.gitkeep
# Configuración de branding: se versiona para que el demo/cliente quede baked-in
!backend/app/static/uploads/brand_config.json
!backend/app/static/uploads/tools/
backend/app/static/uploads/tools/*
!backend/app/static/uploads/tools/.gitkeep
!backend/app/static/uploads/qr/
backend/app/static/uploads/qr/*
!backend/app/static/uploads/qr/.gitkeep
!backend/app/static/uploads/vouchers/
backend/app/static/uploads/vouchers/*
!backend/app/static/uploads/vouchers/.gitkeep

# Instalador / build
dist/
build/
*.spec

# Admin console — contexto de sesión (personal, no compartir)
SESSION.md

# Configs de entorno específicas por cliente en el servidor (no en el repo)
clients/*/.env
clients/*/.env.local

# tenants.json vive fuera del repo en /etc/panol360/{prod,staging}/tenants.json
# Ver scripts/setup-config.sh para crearlo en el servidor.
backend/app/tenants.json

# IDE / OS
.DS_Store
.vscode/
.idea/
