# Pañol 360 — Variables de entorno
# ============================================================
# Copiar este archivo como .env y completar ANTES de arrancar.
# Los valores marcados con ★ son OBLIGATORIOS en producción.
# ============================================================

# ── Base de datos ★ ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://panol:CAMBIAR_DB_PASSWORD@db:5432/panol_db
DB_PASSWORD=CAMBIAR_DB_PASSWORD   # misma clave que en DATABASE_URL

# ── Seguridad ★ ────────────────────────────────────────────
# Genera valores seguros con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# O con el script de setup:
#   sudo bash scripts/setup_production.sh
SECRET_KEY=CAMBIAR_con_secrets_token_hex_32
JWT_SECRET_KEY=CAMBIAR_con_secrets_token_hex_32_distinto

# ── Modo de depuración (false en producción, siempre) ★ ────
DEBUG=false

# ── Empresa (se puede cambiar desde Admin → Personalización) ──
COMPANY_NAME=VMS Ingeniería

# ── Email (opcional) ────────────────────────────────────────
# Si no se configura, las notificaciones por email se omiten en silencio.
# Con Gmail: activar "Contraseñas de aplicación" en la cuenta Google.
# Con otro proveedor: ajustar host y puerto.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@vms-ingenieria.cl
SMTP_PASSWORD=contraseña_de_aplicacion_16_chars

# ── WhatsApp vía Evolution API (recomendado — self-hosted) ──────────────────
# El Jefe escanea un QR desde Notificaciones → WhatsApp. Sin cuenta Meta.
# La URL apunta al contenedor Docker (red interna). La key puede ser cualquier
# string — es la misma que AUTHENTICATION_API_KEY en el contenedor evolution-api.
# Generar con: openssl rand -hex 16
EVOLUTION_API_KEY=
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE=panol360

# ── WhatsApp Business API (legacy — alternativa a Evolution API) ─────────────
# Requiere cuenta Meta Business + número verificado.
# Obtener en: https://developers.facebook.com/docs/whatsapp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ── Admin Panel (acceso vía Tailscale VPN — puerto 9001) ──────────────────
# Usuario del panel de administración de clientes
ADMIN_PANEL_USER=admin
# Hash bcrypt de la contraseña — generar con:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'TuPassword', bcrypt.gensalt()).decode())"
ADMIN_PANEL_PASSWORD_HASH=$2b$12$CAMBIAR_ESTE_HASH_CON_EL_COMANDO_DE_ARRIBA
# Clave de sesión — generar con: openssl rand -hex 32
ADMIN_PANEL_SECRET=CAMBIAR_con_openssl_rand_hex_32
# Token API compartido entre admin-panel y backend para endpoints de admin internos.
# Generar con: openssl rand -hex 32
ADMIN_API_SECRET=CAMBIAR_con_openssl_rand_hex_32
# Entorno: "demo" muestra badge naranja en la UI; "prod" no lo muestra.
PANOL_ENV=demo
